# Контактная форма (заполняем когда подключим)
# Email через Resend (https://resend.com)
RESEND_API_KEY=
SALES_EMAIL=sales@proboxy.ru

# Telegram-бот для дублирования заявок
# Создать бота: @BotFather → /newbot → токен
# Узнать chat_id: написать боту, открыть https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# CRM webhook (Bitrix24 / amoCRM / RetailCRM — позже)
CRM_WEBHOOK_URL=

# Публичный URL сайта (для абсолютных ссылок, OG-картинок)
NEXT_PUBLIC_SITE_URL=https://proboxy.ru
