# =================================
# Админка (/admin)
# =================================
# Email, которому разрешён вход. Все остальные эмейлы получают «ссылка отправлена»
# (для защиты от email enumeration), но письмо им не приходит.
ADMIN_EMAIL=fayrdmit89@gmail.com

# HMAC-секрет для подписи magic-link токенов и сессионных cookies.
# Сгенерировать: openssl rand -base64 32
AUTH_SECRET=

# Resend для отправки magic-link писем. https://resend.com → API Keys → Create
RESEND_API_KEY=
# Отправитель. Для теста можно onboarding@resend.dev (без верификации домена).
EMAIL_FROM=onboarding@resend.dev

# GitHub: куда коммитятся изменения из админки.
# Token: github.com/settings/personal-access-tokens/new → Repository access: только samla,
#        Repository permissions → Contents: Read and write.
GITHUB_TOKEN=
GITHUB_OWNER=fayr89
GITHUB_REPO=samla
# Ветка, в которую коммитим (та же, что и production-deploy в Vercel).
GITHUB_BRANCH=claude/product-landing-page-H9FDX

# Публичный URL (для magic-link в письме и абсолютных ссылок).
NEXT_PUBLIC_SITE_URL=https://samla-sooty.vercel.app

# =================================
# Контактная форма (когда подключим бэкенд)
# =================================
SALES_EMAIL=sales@proboxy.ru

# Telegram-бот для дублирования заявок (опц.)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# CRM webhook (Bitrix24 / amoCRM / RetailCRM — опц.)
CRM_WEBHOOK_URL=
